<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/io.github.livenl.ack05d.plist, replace @BIN@ with the
  installed binary path and @LOG@ with a log file path (install.sh does both), then:
  launchctl bootstrap gui/$UID <plist>.
  KeepAlive relaunches the daemon if it exits; RunAtLoad starts it at login.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.livenl.ack05d</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@LOG@</string>
	<key>StandardOutPath</key>
	<string>@LOG@</string>
</dict>
</plist>
